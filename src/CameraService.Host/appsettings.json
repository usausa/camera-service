{
  "http_ports": "5180",

  "AllowedHosts": "*",

  "Camera": {
    "IdleTime": 10,
    "WarmupTime": 1000,
    "FrameTimeout": 5
  },

  "Stream": {
    "Fps": 10,
    "Quality": 80,
    "H264": {
      "Enable": true,
      "Bitrate": 0,
      "KeyFrameInterval": 2,
      "PreferHardware": true
    }
  },

  "Storage": {
    "Path": "Images"
  },

  "Retention": {
    "Schedule": "0 3 * * *",
    "Days": 30,
    "MinFreeSpace": 10
  },

  "Cameras": [
    {
      "Id": "camera1",
      "Name": "Camera 1",
      "Device": "",
      "DeviceId": "",
      "Format": "Yuy2",
      "Width": 640,
      "Height": 480,
      "Fps": 30,
      "Snapshot": {
        "Enable": true,
        "Schedule": "* * * * *",
        "Path": "",
        "Quality": 90,
        "Timestamp": {
          "Enable": true,
          "Format": "yyyy/MM/dd HH:mm:ss",
          "Position": "BottomRight",
          "Scale": 0
        }
      }
    }
  ],

  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "Enrich": [ "FromLogContext", "WithThreadId" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Extensions.Diagnostics.HealthChecks": "Fatal",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:HH:mm:ss.fff} {Level:u4} [{ThreadId}] - {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "..\\Log\\CameraService_.log",
          "rollingInterval": "Day",
          "outputTemplate": "{Timestamp:HH:mm:ss.fff} {Level:u4} [{ThreadId}] - {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  }
}
